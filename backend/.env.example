# ── Django core ─────────────────────────────────────────────────────────────
SECRET_KEY=generate-a-long-random-string
DEBUG=False
# Comma-separated. Include the api subdomain and the Render host.
ALLOWED_HOSTS=api.pharmax.rauniyaraman.com.np,pharmax-api.onrender.com

# ── URLs (used for CORS, CSRF, and eSewa/Khalti payment callbacks) ───────────
FRONTEND_URL=https://pharmax.rauniyaraman.com.np
BACKEND_URL=https://api.pharmax.rauniyaraman.com.np
CORS_ALLOWED_ORIGINS=https://pharmax.rauniyaraman.com.np
CSRF_TRUSTED_ORIGINS=https://pharmax.rauniyaraman.com.np,https://api.pharmax.rauniyaraman.com.np

# ── Database ─────────────────────────────────────────────────────────────────
# Single connection string from Neon (pooled). Takes precedence over DB_* below.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Local-dev fallback (used only when DATABASE_URL is unset):
DB_NAME=pharmax_next
DB_USER=postgres
DB_PASSWORD=1234
DB_HOST=localhost
DB_PORT=5432

# ── Media storage: Cloudflare R2 (S3-compatible) ─────────────────────────────
USE_R2=True
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
AWS_STORAGE_BUCKET_NAME=pharmax-media
# R2 S3 API endpoint (from the R2 bucket settings):
AWS_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# Public host that serves the objects (R2 public bucket URL or a custom domain):
AWS_S3_CUSTOM_DOMAIN=media.pharmax.rauniyaraman.com.np
AWS_S3_REGION_NAME=auto

# ── Email: Resend (SMTP) ─────────────────────────────────────────────────────
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=your-resend-api-key
EMAIL_FROM=PharmaX <pharmax@rauniyaraman.com.np>

# ── Payments (already in use) ────────────────────────────────────────────────
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=your-esewa-secret
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_VERIFY_URL=https://rc-epay.esewa.com.np/api/epay/transaction/status/
KHALTI_SECRET_KEY=your-khalti-secret
KHALTI_API_URL=https://dev.khalti.com/api/v2
