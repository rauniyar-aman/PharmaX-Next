# Public API base URL — the browser calls this directly, so it must be the api subdomain.
NEXT_PUBLIC_API_URL=https://api.pharmax.rauniyaraman.com.np/api

# Backend origin, used to resolve backend-relative media URLs (see lib/resolveImg.ts).
NEXT_PUBLIC_BACKEND_URL=https://api.pharmax.rauniyaraman.com.np

# Optional: public host that serves uploaded media (Cloudflare R2 custom domain).
# Only needed if media is served from a different host than the backend.
NEXT_PUBLIC_MEDIA_URL=https://media.pharmax.rauniyaraman.com.np
